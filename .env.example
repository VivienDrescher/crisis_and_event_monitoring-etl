# ------------------------------
# General
# ------------------------------
ENV=local             # local / dev / prod: : solely informational at this point
EBUG=False            # True = verbose logging, faster retries
LOG_LEVEL=INFO        # DEBUG, INFO, WARNING, ERRORLOG_LEVEL=INFO: Logging verbosity

# ------------------------------
# Paths (machine-specific)
# ------------------------------
DATA_ROOT=data                     # Root folder for all data
LANDING_PATH=${DATA_ROOT}/landing  # Raw downloaded files are stored here
BRONZE_PATH=${DATA_ROOT}/bronze    # Raw files are stored here as parquet
SILVER_PATH=${DATA_ROOT}/silver    # Cleaned data is stored here
GOLD_PATH=${DATA_ROOT}/gold        # Final, merged and aggregated data is stored here
LOG_PATH=logs                      # Log files folder
CONFIG_PATH=config                 # Config files folder

# ------------------------------
# Network / download behavior
# ------------------------------
DOWNLOAD_TIMEOUT=60   # Max seconds to wait for a download
MAX_RETRIES=3         # Number of downlad retry attempts 
RETRY_BACKOFF=5       # Seconds to wait between retries (1s if DEBUG=True)

# ------------------------------
# Postgres Credentials
# ------------------------------
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_password
POSTGRES_DB=portfolio_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
